# Super Search Desktop — settings template. Copied to .env on first launch.
#
# Holds SECRETS and DEPLOYMENT values only. Recognition/pipeline parameters are
# FROZEN in modules/frozen_config.py (no in-app Settings page). See ENVIRONMENT.md.

# ---- REQUIRED: your Google Gemini API key(s) ----
# Get one free at https://aistudio.google.com/apikey — paste it below.
# Multiple keys (comma-separated) tag faster by load-balancing. Never commit a real key.
GEMINI_API_KEYS=YOUR_API_KEY_HERE

# ---- App ----
APP_MODE=pywebview
APP_PORT=8765
TOURNAMENT_NAME=IPL 2026

# ---- Optional: video speech-to-text (faster-whisper) ----
# OFF by default (native int8 CPU inference segfaults on some machines).
ENABLE_TRANSCRIBE=false
