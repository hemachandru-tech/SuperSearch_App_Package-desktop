# --- Secrets / config (NEVER commit) ---
.env
.env.local

# --- Packages / dependencies ---
node_modules/
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

# --- Build output ---
dist/
build/
Client_Delivery/

# --- App runtime state & caches (written next to the code) ---
